generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  channel   String?
  user      String?
  reason    String?
  admin     String?
  expiresAt DateTime?
}

model Channel {
  id        String   @id
  readOnly  Boolean
  allowlist String[]
}

model Bans {
  id        Int       @id @default(autoincrement())
  user      String?
  reason    String?
  admin     String?
  expiresAt DateTime?
}

model Slowmode {
  id               Int       @id @default(autoincrement())
  channel          String
  locked           Boolean?  @default(false)
  time             Int?
  admin            String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  reason           String?
  threadTs         String    @default("")
  updatedAt        DateTime  @default(now()) @updatedAt
  whitelistedUsers String[]  @default([])
  applyToThreads   Boolean   @default(false)

  @@unique([channel, threadTs], name: "channel_threadTs")
}

model SlowUsers {
  id            Int      @id @default(autoincrement())
  channel       String
  user          String
  lastMessageAt Int?
  whitelist     Boolean? @default(false)
  threadTs      String   @default("")

  @@unique([channel, threadTs, user], name: "channel_threadTs_user")
}

model Thread {
  id        String    @id @unique
  createdAt DateTime  @default(now())
  admin     String
  lock_type String
  time      DateTime?
  reason    String
  channel   String?
  active    Boolean?
}

model Log {
  id        String    @id @unique @default(nanoid())
  thread_id String
  createdAt DateTime  @default(now())
  admin     String
  lock_type String
  time      DateTime?
  reason    String
  channel   String?
  active    Boolean?
}

model AccountAgeGate {
  channelId  String   @id
  minAgeDays Int
  setBy      String
  createdAt  DateTime @default(now())
}

model MemberJoinDate {
  userId       String    @id
  joinedAt     DateTime?
  messageCount Int       @default(0)
}

model FlaggedMessage {
  id          String    @id @unique @default(nanoid())
  flaggedWord String
  user        String
  channel     String
  messageText String
  messageTs   String
  threadTs    String?
  createdAt   DateTime  @default(now())
}

model BotWhitelist {
  channelId String   @id
  enabled   Boolean  @default(false)
  botIds    String[] @default([])
}

model AutoresponseCooldown {
  userId     String   @id
  lastSentAt DateTime @default(now())
}
